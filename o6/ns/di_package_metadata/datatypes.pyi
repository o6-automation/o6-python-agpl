from typing import Any, Sequence, SupportsFloat

import numpy as np

_Integer = int | np.integer[Any]

_Boolean = bool | np.bool_

import enum

from o6.node import ObjectNode as _ObjectNode, VariableNode as _VariableNode

import uuid

import o6

import o6.ns.ns0 as ns0

class PackageType(enum.IntEnum):
    FIRMWARE = 0
    APPLICATION = 1
    CONFIGURATION = 2
    SOLUTION = 3

class FileType(enum.IntEnum):
    DEPLOYMENT_ITEM = 0
    RELEASE_NOTES = 1
    LICENSE_INFO = 2
    PRE_INSTALL_NOTE = 3

class FileDescriptor(ns0.datatypes.Structure):
    @property
    def fileType(self) -> FileType: ...
    @fileType.setter
    def fileType(self, value: _Integer) -> None: ...
    @property
    def fileName(self) -> o6.String: ...
    @fileName.setter
    def fileName(self, value: o6.String) -> None: ...
    @property
    def mimeType(self) -> o6.String | None: ...
    @mimeType.setter
    def mimeType(self, value: o6.String | None) -> None: ...
    @property
    def language(self) -> o6.String | None: ...
    @language.setter
    def language(self, value: o6.String | None) -> None: ...

class ComparisonOperation(enum.IntEnum):
    EQUAL_TO = 0
    GREATER_THAN = 1
    GREATER_EQUAL = 2
    LESS_THEN = 3
    LESS_EQUAL = 4
    REGULAR_EXPRESSION = 5
    ONE_OF = 6
    EXIST = 7

class CompatibilityRequirement(ns0.datatypes.Structure):
    @property
    def variable(self) -> o6.String: ...
    @variable.setter
    def variable(self, value: o6.String) -> None: ...
    @property
    def values(self) -> list[Any]: ...
    @values.setter
    def values(self, value: Sequence[Any]) -> None: ...
    @property
    def operation(self) -> ComparisonOperation: ...
    @operation.setter
    def operation(self, value: _Integer) -> None: ...

class CompatibilityOption(ns0.datatypes.Structure):
    @property
    def compatibilityRequirements(self) -> list[CompatibilityRequirement]: ...
    @compatibilityRequirements.setter
    def compatibilityRequirements(self, value: Sequence[CompatibilityRequirement]) -> None: ...

class FxPathElement(ns0.datatypes.Structure):
    @property
    def assetConnectorType(self) -> o6.NodeId: ...
    @assetConnectorType.setter
