    @property
    def connectorId(self) -> o6.UInt16 | None: ...
    @connectorId.setter
    def connectorId(self, value: _Integer | None) -> None: ...
    @property
    def connectorName(self) -> o6.String | None: ...
    @connectorName.setter
    def connectorName(self, value: o6.String | None) -> None: ...

