from typing import Any, Sequence, SupportsFloat

import numpy as np

_Integer = int | np.integer[Any]

_Boolean = bool | np.bool_

import enum

from o6.node import ObjectNode as _ObjectNode, VariableNode as _VariableNode

import uuid

import o6

import o6.ns.ns0 as ns0

class ResultEvaluationEnum(enum.IntFlag):
    """Indicates whether a result was in tolerance"""

    UNDEFINED = 0
    OK = 1
    NOT_OK = 2
    NOT_DECIDABLE = 3

class BaseResultTransferOptionsDataType(ns0.datatypes.Structure):
    """Abstract type containing information which file should be provided."""

    @property
    def resultId(self) -> o6.String: ...
    @resultId.setter
    def resultId(self, value: o6.String) -> None: ...

class ResultTransferOptionsDataType(BaseResultTransferOptionsDataType):
    """Contains information which file should be provided."""

    @property
    def resultId(self) -> o6.String: ...
    @resultId.setter
    def resultId(self, value: o6.String) -> None: ...

class ProcessingTimesDataType(ns0.datatypes.Structure):
    """Contains measured times that were generated during the execution of a recipe."""

    @property
    def startTime(self) -> o6.DateTime: ...
    @startTime.setter
    def startTime(self, value: o6.DateTime) -> None: ...
    @property
    def endTime(self) -> o6.DateTime: ...
    @endTime.setter
    def endTime(self, value: o6.DateTime) -> None: ...
    @property
    def acquisitionDuration(self) -> o6.Double | None: ...
    @acquisitionDuration.setter
    def acquisitionDuration(self, value: SupportsFloat | None) -> None: ...
    @property
    def processingDuration(self) -> o6.Double | None: ...
    @processingDuration.setter
    def processingDuration(self, value: SupportsFloat | None) -> None: ...

class ResultMetaDataType(ns0.datatypes.Structure):
    """Meta data of a result, describing the result."""

    @property
    def resultId(self) -> o6.String: ...
    @resultId.setter
    def resultId(self, value: o6.String) -> None: ...
    @property
    def hasTransferableDataOnFile(self) -> o6.Boolean | None: ...
    @hasTransferableDataOnFile.setter
    def hasTransferableDataOnFile(self, value: _Boolean | None) -> None: ...
    @property
    def isPartial(self) -> o6.Boolean | None: ...
    @isPartial.setter
    def isPartial(self, value: _Boolean | None) -> None: ...
    @property
    def isSimulated(self) -> o6.Boolean | None: ...
    @isSimulated.setter
    def isSimulated(self, value: _Boolean | None) -> None: ...
    @property
    def resultState(self) -> o6.Int32 | None: ...
    @resultState.setter
    def resultState(self, value: _Integer | None) -> None: ...
    @property
    def stepId(self) -> o6.String | None: ...
    @stepId.setter
    def stepId(self, value: o6.String | None) -> None: ...
    @property
    def partId(self) -> o6.String | None: ...
    @partId.setter
    def partId(self, value: o6.String | None) -> None: ...
    @property
    def externalRecipeId(self) -> o6.String | None: ...
    @externalRecipeId.setter
    def externalRecipeId(self, value: o6.String | None) -> None: ...
    @property
    def internalRecipeId(self) -> o6.String | None: ...
    @internalRecipeId.setter
    def internalRecipeId(self, value: o6.String | None) -> None: ...
    @property
    def productId(self) -> o6.String | None: ...
    @productId.setter
    def productId(self, value: o6.String | None) -> None: ...
    @property
    def externalConfigurationId(self) -> o6.String | None: ...
    @externalConfigurationId.setter
    def externalConfigurationId(self, value: o6.String | None) -> None: ...
    @property
    def internalConfigurationId(self) -> o6.String | None: ...
    @internalConfigurationId.setter
    def internalConfigurationId(self, value: o6.String | None) -> None: ...
    @property
    def jobId(self) -> o6.String | None: ...
    @jobId.setter
    def jobId(self, value: o6.String | None) -> None: ...
    @property
    def creationTime(self) -> o6.DateTime | None: ...
    @creationTime.setter
    def creationTime(self, value: o6.DateTime | None) -> None: ...
    @property
    def processingTimes(self) -> ProcessingTimesDataType | None: ...
    @processingTimes.setter
    def processingTimes(self, value: ProcessingTimesDataType | None) -> None: ...
    @property
    def resultUri(self) -> list[o6.String] | None: ...
    @resultUri.setter
    def resultUri(self, value: Sequence[o6.String] | None) -> None: ...
    @property
    def resultEvaluation(self) -> ResultEvaluationEnum | None: ...
    @resultEvaluation.setter
    def resultEvaluation(self, value: _Integer | None) -> None: ...
    @property
    def resultEvaluationCode(self) -> o6.Int64 | None: ...
    @resultEvaluationCode.setter
    def resultEvaluationCode(self, value: _Integer | None) -> None: ...
    @property
    def resultEvaluationDetails(self) -> o6.LocalizedText | None: ...
    @resultEvaluationDetails.setter
    def resultEvaluationDetails(self, value: o6.LocalizedText | None) -> None: ...
    @property
    def fileFormat(self) -> list[o6.String] | None: ...
    @fileFormat.setter
    def fileFormat(self, value: Sequence[o6.String] | None) -> None: ...

class ResultDataType(ns0.datatypes.Structure):
    """Contains fields that were created during the execution of a recipe."""

    @property
    def resultMetaData(self) -> ResultMetaDataType: ...
    @resultMetaData.setter
    def resultMetaData(self, value: ResultMetaDataType) -> None: ...
    @property
    def resultContent(self) -> list[Any]: ...
    @resultContent.setter
    def resultContent(self, value: Sequence[Any]) -> None: ...
